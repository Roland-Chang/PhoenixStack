# {{ ansible_managed }}
# Shared middlewares (role traefik).
http:
  middlewares:
    # Admin sources only: the same list as pve01's ADMIN_SOURCES and the UDM's Management rules.
    admin-only:
      ipAllowList:
        sourceRange:
{% for s in admin_sources %}
          - "{{ s }}"
{% endfor %}
    # Nobody (403): for a route's blocked_paths.
    deny-all:
      ipAllowList:
        sourceRange:
          - "127.0.0.1/32"
