# {{ ansible_managed }}
# Route "{{ route.name }}" from the inventory (docker host {{ inventory_hostname }}).
http:
  routers:
    {{ route.name }}:
      rule: "Host(`{{ route.name }}.{{ domain }}`)"
      entryPoints:
        - websecure
      service: {{ 'api@internal' if route.url == 'api@internal' else route.name }}
{% if route.admin_only | default(false) %}
      middlewares:
        - admin-only@file
{% endif %}
{% if route.url != 'api@internal' %}
  services:
    {{ route.name }}:
      loadBalancer:
        servers:
          - url: "{{ route.url }}"
{% endif %}
