# {{ ansible_managed }}
# Login through Authentik (role traefik). Routes with `authentik: true` use the middleware
# "authentik": Traefik asks Authentik's embedded outpost whether the request is logged in, and
# sends the browser to https://auth.{{ domain }} if not. Authentik decides who may in
# (the app's group binding, from the same inventory route).
http:
  middlewares:
    authentik:
      forwardAuth:
        address: "{{ traefik_authentik_url }}/outpost.goauthentik.io/auth/traefik"
        # The entrypoint doesn't trust clients' X-Forwarded-* headers (no trustedIPs), so what
        # reaches Authentik is what Traefik set itself.
        trustForwardHeader: true
        tls:
          # Authentik's own self-signed certificate; its firewall accepts this host only.
          insecureSkipVerify: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid

  # The outpost's own paths (/outpost.goauthentik.io/: login callback, sign-out) on each
  # protected name go straight to Authentik.
  services:
    authentik-outpost:
      loadBalancer:
        servers:
          - url: "{{ traefik_authentik_url }}"
        serversTransport: authentik-outpost
  serversTransports:
    authentik-outpost:
      insecureSkipVerify: true
