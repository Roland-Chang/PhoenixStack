# {{ ansible_managed }}
# n8n (role apps, L5h step 5). Reached through Traefik only, behind Authentik forward-auth (admins):
# route {{ apps_catalog.n8n.route }} → http://{{ stack.name }}:{{ apps_catalog.n8n.port }}. Database on pgsql01.
{% set n8n = apps_catalog.n8n %}
{% set n8n_host = n8n.route ~ '.' ~ (routes_domain | default(domain)) %}
name: {{ stack.name }}

services:
  n8n:
    image: docker.n8n.io/n8nio/n8n:{{ stack.version or n8n.version }}
    container_name: {{ stack.name }}
    restart: unless-stopped
    user: "{{ n8n.uid }}:{{ n8n.uid }}"
    networks:
      - proxy
    environment:
      TZ: {{ app_timezone }}
      # Its uid has no account in the image, so its home would be / (n8n then tries to create /.n8n).
      # The data folder is mounted as the whole home: n8n keeps its data in <N8N_USER_FOLDER>/.n8n and its
      # cache in <N8N_USER_FOLDER>/.cache, both inside it (/home/node itself belongs to the image's user).
      HOME: /home/node
      N8N_USER_FOLDER: /home/node
      GENERIC_TIMEZONE: {{ app_timezone }}
      N8N_HOST: {{ n8n_host }}
      N8N_PROTOCOL: https
      N8N_PORT: "{{ n8n.port }}"
      N8N_WEBHOOK_URL: https://{{ n8n_host }}/
      N8N_PROXY_HOPS: "1"
      # Every credential n8n stores is encrypted with this key (1Password; never change it).
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY:?no .env}
      # PostgreSQL on pgsql01 over TLS (as Authentik: encrypted, certificate not checked).
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: postgres.{{ domain }}
      DB_POSTGRESDB_PORT: "5432"
      DB_POSTGRESDB_DATABASE: n8n
      DB_POSTGRESDB_USER: n8n
      DB_POSTGRESDB_PASSWORD: ${DB_POSTGRESDB_PASSWORD:?no .env}
      DB_POSTGRESDB_SSL_ENABLED: "true"
      DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED: "false"
      # Runs history: pruned after {{ n8n.prune_hours }} hours.
      EXECUTIONS_DATA_PRUNE: "true"
      EXECUTIONS_DATA_MAX_AGE: "{{ n8n.prune_hours }}"
      # Nothing leaves for n8n's own services: no telemetry, update checks, templates or n8n's AI assistant.
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_VERSION_NOTIFICATIONS_ENABLED: "false"
      N8N_TEMPLATES_ENABLED: "false"
      N8N_PERSONALIZATION_ENABLED: "false"
      N8N_HIRING_BANNER_ENABLED: "false"
      N8N_AI_ENABLED: "false"
      # No public REST API for now (workflows are built in the editor).
      N8N_PUBLIC_API_DISABLED: "true"
    volumes:
      - ./data:/home/node
    mem_limit: 2g
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ n8n.port }}/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

networks:
  proxy:
    external: true
