# {{ ansible_managed }}
{% if stack.staging %}
# Mealie, staging copy (role apps, decision 11). LAN and VPN only, admins only: route
# {{ apps_catalog.mealie.route }}-staging → http://{{ stack.name }}:9000. Data restored from production's backup.
{% set mealie_route = apps_catalog.mealie.route ~ '-staging' -%}
{% else %}
# Mealie (role apps). Reached through Traefik only: route {{ apps_catalog.mealie.route }} → http://mealie:9000.
{% set mealie_route = apps_catalog.mealie.route -%}
{% endif %}
name: {{ stack.name }}

services:
  mealie:
    image: ghcr.io/mealie-recipes/mealie:{{ stack.version or apps_catalog.mealie.version }}
    container_name: {{ stack.name }}
    restart: unless-stopped
    # Started as its own uid, with PUID equal to it, the image's run.sh skips its root-only steps
    # (usermod, chown -R /app, gosu), so no capabilities are needed.
    user: "{{ apps_catalog.mealie.uid }}:{{ apps_catalog.mealie.uid }}"
    networks:
      - proxy
    environment:
      TZ: {{ app_timezone }}
      PUID: "{{ apps_catalog.mealie.uid }}"
      PGID: "{{ apps_catalog.mealie.uid }}"
      ALLOW_SIGNUP: "false"
      DEFAULT_GROUP: {{ apps_catalog.mealie.default_group }}
      DEFAULT_HOUSEHOLD: {{ apps_catalog.mealie.default_household }}
      BASE_URL: https://{{ mealie_route }}.{{ routes_domain | default(domain) }}
      # Mealie's daily jobs, in TZ's time (docker-temp misspelled the name, so they ran at 23:45 UTC).
      DAILY_SCHEDULE_TIME: "03:00"
      LOG_LEVEL: INFO
{% if stack.env_op.OIDC_CLIENT_SECRET is defined %}
      # Logins through Authentik (client {{ mealie_route }}); the secret from .env (root only, role apps).
      OIDC_AUTH_ENABLED: "true"
      OIDC_CONFIGURATION_URL: https://auth.{{ public_domain }}/application/o/{{ mealie_route }}/.well-known/openid-configuration
      OIDC_CLIENT_ID: {{ mealie_route }}
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?no .env}
      OIDC_PROVIDER_NAME: PhoenixStack
      OIDC_AUTO_REDIRECT: "true"
      OIDC_SIGNUP_ENABLED: "true"
      OIDC_USER_CLAIM: email
      OIDC_ADMIN_GROUP: {{ apps_catalog.mealie.oidc_admin_group }}
      OIDC_REMEMBER_ME: "true"
      ALLOW_PASSWORD_LOGIN: "{{ apps_catalog.mealie.password_login | string | lower }}"
{% endif %}
    volumes:
      - ./data:/app/data
    mem_limit: 1g
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://127.0.0.1:9000/api/app/about"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s

networks:
  proxy:
    external: true
