# {{ ansible_managed }}
# PhoenixStack: apps behind Traefik's forward-auth (role authentik; guests/README.md, L5e).
# Built from the inventory: every Docker host route with `authentik: true` gets a proxy provider
# (forward auth, single application), an application, a group binding and a place on the
# embedded outpost. Authentik re-applies this hourly; change routes in the inventory, not the UI.
#
# Removing a route doesn't delete its app here: delete it in the UI (or set state: absent).
version: 1
metadata:
  name: PhoenixStack - Proxy apps
  labels:
    blueprints.goauthentik.io/description: Forward-auth apps from the inventory's routes
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Provider authorization flow (implicit consent)
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Provider invalidation flow
      required: true
{% for app in authentik_proxy_apps %}

  # --- {{ app.title | default(app.name) }}: https://{{ app.name }}.{{ domain }}
  - model: authentik_providers_proxy.proxyprovider
    id: provider-{{ app.name }}
    identifiers:
      name: {{ app.title | default(app.name) }}
    attrs:
      mode: forward_single
      external_host: https://{{ app.name }}.{{ domain }}
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    id: app-{{ app.name }}
    identifiers:
      slug: {{ app.name }}
    attrs:
      name: {{ app.title | default(app.name) }}
      provider: !KeyOf provider-{{ app.name }}
      meta_launch_url: https://{{ app.name }}.{{ domain }}
      policy_engine_mode: any
  # Only this group gets in (an application with no binding lets every user in).
  - model: authentik_policies.policybinding
    identifiers:
      order: 0
      target: !KeyOf app-{{ app.name }}
    attrs:
      group: !Find [authentik_core.group, [name, {{ app.authentik_group | default('authentik Admins') }}]]
{% endfor %}

  # The embedded outpost (inside the Authentik server) answers Traefik's forward-auth checks
  # for these providers. This list is the whole list: providers not named here are removed.
  - model: authentik_outposts.outpost
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
{% for app in authentik_proxy_apps %}
        - !KeyOf provider-{{ app.name }}
{% else %}
        []
{% endfor %}
