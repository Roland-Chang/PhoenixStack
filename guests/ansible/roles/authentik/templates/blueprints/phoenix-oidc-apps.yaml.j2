# {{ ansible_managed }}
# PhoenixStack: apps that log in through their own OIDC support (role authentik; decision 3,
# guests/README.md). Built from the inventory: every Docker host route with `oidc` gets an OAuth2/OIDC
# provider (client ID = route name; Authentik generates the secret once, and it's entered in the app,
# never in git), an application, and bindings to the groups that may use it.
# Authentik re-applies this hourly; change routes in the inventory, not the UI.
version: 1
metadata:
  name: PhoenixStack - OIDC apps
  labels:
    blueprints.goauthentik.io/description: OIDC clients for apps from the inventory's routes
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Provider authorization flow (implicit consent)
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: PhoenixStack - People and Google sign-in
      required: true

  # Authentik's own email mapping says email_verified: false. Ours says true: each email is set by an
  # admin and is the address the person signs in to Google with (Google has verified it). Apps that
  # match existing accounts by email (Audiobookshelf) need it.
  - model: authentik_providers_oauth2.scopemapping
    id: email-verified
    identifiers:
      name: "PhoenixStack: email (verified)"
    state: present
    attrs:
      scope_name: email
      description: "Email address"
      expression: |
        return {
            "email": request.user.email,
            "email_verified": True,
        }
{% for app in authentik_oidc_apps %}

  # {{ app.oidc.title }}: https://{{ app.host }}
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-{{ app.name }}
    identifiers:
      name: "OIDC - {{ app.oidc.title }}"
    state: present
    attrs:
      client_id: {{ app.name }}
      client_type: confidential
      # Must be listed: the default is none (the UI fills it in, a blueprint doesn't). Code flow only;
      # refresh tokens for apps that keep sessions (Audiobookshelf's phone app).
      grant_types: [authorization_code, refresh_token]
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: hashed_user_id
      include_claims_in_id_token: true
      redirect_uris:
{% for path in app.oidc.redirects %}
        - matching_mode: strict
          url: "https://{{ app.host }}{{ path }}"
{% endfor %}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !KeyOf email-verified
  - model: authentik_core.application
    id: app-{{ app.name }}
    identifiers:
      slug: {{ app.name }}
    state: present
    attrs:
      name: "{{ app.oidc.title }}"
      provider: !KeyOf provider-{{ app.name }}
      meta_launch_url: "https://{{ app.host }}"
      policy_engine_mode: any
{% for group in app.oidc.groups %}
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-{{ app.name }}
      group: !Find [authentik_core.group, [name, "{{ group }}"]]
    state: present
    attrs:
      order: {{ loop.index0 }}
{% endfor %}
{% endfor %}
