{
  "live-restore": true,
  "no-new-privileges": true,
  "log-driver": "local",
  "log-opts": {
    "max-size": "{{ docker_log_max_size }}",
    "max-file": "{{ docker_log_max_file }}"
  },
  "default-address-pools": [
    { "base": "{{ docker_address_pool }}", "size": {{ docker_address_pool_size }} }
  ]
}
