# Proxmox LXC Backup Configuration ({{ ansible_date_time.iso8601 }})
# Format: VMID:HOSTNAME:RETENTION_DAYS
# 
# RETENTION_DAYS determines snapshot history:
# - 14 days: Critical services (databases, DNS)
# - 7 days: Standard services (proxy, auth, bastion, control plane)
# 
# This file is managed by Ansible - do not edit manually.
# Update via: ansible/roles/proxmox_backup/templates/proxmox-backups.conf.j2

