# 1Password Service Account Token - Vault Template
# 
# This file should be encrypted with ansible-vault for secure storage
# 
# SETUP:
#   1. Create this file: ansible/vault/onepassword.yml
#   2. Edit it: nano ansible/vault/onepassword.yml (add token)
#   3. Encrypt it: ansible-vault encrypt ansible/vault/onepassword.yml
#   4. Use with playbook: 
#      ansible-playbook -i ansible/inventory/hosts.yml ansible/playbooks/bastion01_onepassword.yml \
#        --vault-id @prompt -e @ansible/vault/onepassword.yml

---
# 1Password Service Account Token
# Created in 1Password: Settings → Integrations → Service Accounts
# https://developer.1password.com/docs/service-accounts/get-started/
#
# ⚠️  CRITICAL: Never commit this unencrypted. Always use ansible-vault.
# ⚠️  The token is only displayed once. Keep it safe.
#
# To get a new token:
#   1. Go to 1password.com → Settings → Integrations → Service Accounts
#   2. Click the service account (phoenixstack-automation)
#   3. Click "Credentials" → "Show credentials"
#   4. Copy the service account token (long alphanumeric string)
#   5. Replace the placeholder below
onepassword_service_account_token: "YOUR_SERVICE_ACCOUNT_TOKEN_HERE"
