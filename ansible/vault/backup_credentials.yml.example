# Backup Share SMB/CIFS Credentials
# This file contains credentials for mounting the Backups share
#
# To create/edit the encrypted vault file:
#   ansible-vault create --vault-password-file ~/.vault_pass ansible/vault/backup_credentials.yml
#   ansible-vault edit --vault-password-file ~/.vault_pass ansible/vault/backup_credentials.yml
#
# Add the following variables with your SMB credentials:

backup_share_user: "your_smb_username"
backup_share_password: "your_smb_password"
