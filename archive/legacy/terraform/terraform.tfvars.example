# PhoenixStack Terraform - Configuration Template
# 
# This file serves as documentation for terraform.tfvars configuration
# DO NOT use this file for actual deployments
# Instead, create terraform.tfvars with your actual credentials
#
# SECURITY BEST PRACTICES:
# 1. Local Development:
#    - Copy this file to terraform.tfvars
#    - Fill in actual Proxmox credentials
#    - Ensure terraform.tfvars is in .gitignore (it already is)
#    - Never commit terraform.tfvars to git
#
# 2. GitHub Actions / Remote Execution:
#    - Store Proxmox credentials as GitHub Secrets:
#      * PROXMOX_API_URL
#      * PROXMOX_API_TOKEN_ID
#      * PROXMOX_API_TOKEN_SECRET
#    - GitHub Actions will inject these at runtime via self-hosted runner
#    - terraform.tfvars becomes unnecessary
#    - terraform plan/apply runs on bastion01 self-hosted runner

# ============================================================================
# PROXMOX API CONFIGURATION
# ============================================================================

# Proxmox API URL
# Format: https://<ip-or-hostname>:<port>/api2/json/
# Recommendation: Use static IP (10.101.0.11) rather than DNS name
# Reason: Ensures availability if DNS/DHCP is misconfigured
proxmox_api_url = "https://10.101.0.11:8006/api2/json/"

# Proxmox API Token ID
# Format: user@realm!tokenname
# To create a token in Proxmox:
#   1. Datacenter > API Tokens > Create Token
#   2. Use user: root@pam
#   3. Use token name: terraform-token
#   4. Grant permissions: Datastore.Allocate, Datastore.AllocateSpace, Datastore.Audit, SDN.Use, Sys.Audit, VM.Allocate, VM.Audit, VM.CLone, VM.Config.CDROM, VM.Config.CPU, VM.Config.CloudInit, VM.Config.Disk, VM.Config.HYType, VM.Config.Memory, VM.Config.Network, VM.Config.Options, VM.Console, VM.PowerMgmt
#   5. Copy the token ID and secret
proxmox_api_token_id = "root@pam!terraform-token"

# Proxmox API Token Secret
# This is the token password/secret generated when creating the token in Proxmox
# Value: Copy from 1Password "Proxmox Terraform Token" entry
# WARNING: This is a sensitive credential. Never commit to git.
proxmox_api_token_secret = "YOUR_ACTUAL_TOKEN_SECRET_HERE"

# ============================================================================
# SSH PUBLIC KEY CONFIGURATION
# ============================================================================

# SSH public key to install in all container root accounts
# This key will be installed for password-less root access
