# MONITOR02 Container - Terraform Configuration
# Grafana visualization and dashboards (HA partner)

terraform {
  required_version = ">= 1.5"
  required_providers {
    proxmox = {
      source  = "telmate/proxmox"
      version = "3.0.2-rc04"
    }
  }
}

module "monitor02" {
  source = "../modules/lxc"

  proxmox_node = var.proxmox_node
  vmid         = var.container_vmid
  hostname     = var.hostname
  ostemplate   = var.ostemplate

  cpu_cores    = var.cpu_cores
  memory_mb    = var.memory_mb
  swap_mb      = var.swap_mb
  storage_pool = var.storage_pool
  storage_size = var.storage_size

  ip_address     = var.ip_address
  ip_cidr_suffix = var.ip_cidr_suffix
  gateway        = var.gateway
  network_bridge = var.network_bridge
  nameserver     = var.nameserver
  search_domain  = var.search_domain

  ssh_public_keys = var.ssh_public_keys
  mac_address     = var.mac_address

  enable_nesting = true
  unprivileged   = true
  autostart      = true
  onboot         = true
}

output "monitor02_vmid" {
  description = "MONITOR02 container ID"
  value       = module.monitor02.vmid
}

output "monitor02_ip" {
  description = "MONITOR02 IP address"
  value       = module.monitor02.ip_address
}

output "monitor02_hostname" {
  description = "MONITOR02 hostname"
  value       = module.monitor02.hostname
}
