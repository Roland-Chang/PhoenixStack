# Ignore sensitive files and directories.
# Comments must be on their own line: git treats a trailing "# ..." as part of the pattern.

# Proxmox unattended installer: the ISO and answer file contain the root password hash
*.iso
answer.toml

# Terraform (state and variable files hold credentials)
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.*
**/terraform.tfvars
**/*.auto.tfvars
**/tfplan*
**/plan_output_*.txt
# .terraform.lock.hcl is NOT ignored: commit it to pin provider versions

# Ansible
**/group_vars/*.secrets.yml
**/host_vars/*.secrets.yml
**/.vault_pass
**/.ansible_vault_pass
**/vault_pass.txt

# Credentials: files that hold secret values. Kept narrow on purpose: broad patterns such
# as token* or secret* would silently ignore source files (tokens.tf, a secrets role, ...).
.env
.env.*
!.env.example
**/credentials
*.cred
*.secret
*.pem
*.key
*.p12
*.pfx

# SSH
**/.ssh/id_*
**/.ssh/known_hosts

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
.cache/
