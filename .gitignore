# Ignore sensitive files and directories

# Terraform
**/.terraform/
# .terraform.lock.hcl is NOT ignored - it should be committed to ensure consistent provider versions
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfstate.*.backup
**/.terraform.tfvars
terraform/terraform.tfvars       # CRITICAL: Contains Proxmox API credentials - NEVER commit
**/terraform.tfvars.*.auto.tfvars
**/tfplan*
**/plan_output_*.txt
**/.env
# Use terraform.tfvars.example as a template instead

# Ansible
inventory/group_vars/*.secrets.yml
inventory/host_vars/*.secrets.yml
ansible/vault/*.yml              # CRITICAL: Encrypted vault files - NEVER commit unencrypted
!ansible/vault/*.example         # But DO include examples
ansible/vault/.vault_pass        # CRITICAL: Vault password file - NEVER commit
**/.ansible_vault_pass
**/vault_pass.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.venv
env/
venv/
ENV/
.vscode-test

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# SSH
**/.ssh/id_rsa
**/.ssh/id_ed25519
**/.ssh/known_hosts

# Credentials
.env
.env.local
.env.*.local
**/credentials
**/secret*
**/password*
**/api_key*
**/token*

# Logs
*.log
logs/

# Temporary
*.tmp
*.temp
.cache/
.pytest_cache/
.fact_cache/

# Proxmox unattended installer: the ISO and answer file contain the root password hash
*.iso
answer.toml
